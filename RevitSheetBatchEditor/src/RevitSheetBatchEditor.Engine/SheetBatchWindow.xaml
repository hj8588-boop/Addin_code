<Window x:Class="RevitSheetBatchEditor.Engine.SheetBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheet Batch Editor" Height="900" Width="1180"
        MinHeight="620" MinWidth="940" WindowStartupLocation="CenterScreen"
        Background="#F6F7F9" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0F766E"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0D665F"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0FDFA"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5EEAD4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CCFBF1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Grid.RowSpan="2" Margin="0,9,0,0" Background="White"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"/>
                            <Border Margin="16,0,0,0" Padding="7,0" Background="#F6F7F9" HorizontalAlignment="Left">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="11,12,11,11"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D1D5DB"/>
            <Setter Property="RowHeight" Value="29"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style x:Key="CenteredCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E8EEF3"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenteredColumnHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="450"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Select All" Width="82" Margin="0,0,6,0" Click="SelectAll_Click"/>
                <Button Content="Clear All" Width="82" Margin="0,0,12,0" Click="ClearAll_Click"/>
                <Button Content="Export Excel" Width="105" Margin="0,0,6,0" Click="ExportExcel_Click"/>
                <Button Content="Import Excel" Width="105" Margin="0,0,14,0" Click="ImportExcel_Click"/>
                <TextBlock Text="Search" Margin="0,0,6,0" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBox x:Name="SearchBox" Width="230" TextChanged="SearchBox_TextChanged"/>
            </StackPanel>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <GroupBox Grid.Row="2" Header="Automatic Sheet Numbering" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                <StackPanel.RenderTransform>
                    <TranslateTransform Y="-3"/>
                </StackPanel.RenderTransform>
                <TextBlock Text="Prefix" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="NumberPrefixBox" Width="90" Margin="0,0,14,0"/>
                <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="StartNumberBox" Text="1" Width="60" Margin="0,0,14,0"/>
                <TextBlock Text="Digits" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="NumberDigitsBox" Text="3" Width="45" Margin="0,0,14,0"/>
                <TextBlock Text="Increment" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="NumberIncrementBox" Text="1" Width="45" Margin="0,0,14,0"/>
                <TextBlock Text="Suffix" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="NumberSuffixBox" Width="80" Margin="0,0,18,0"/>
                <Button Content="Generate Numbers" Width="125" Height="26" Margin="0,0,8,0" Click="GenerateNumbers_Click"/>
                <Button Content="Restore Numbers" Width="115" Height="26" Click="ResetNumbers_Click"/>
            </StackPanel>
        </GroupBox>

        <DataGrid x:Name="SheetGrid" Grid.Row="3" AutoGenerateColumns="False"
                  CanUserAddRows="False" SelectionUnit="FullRow" SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="All" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"
                                        HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                        ElementStyle="{StaticResource CenteredCheckBoxStyle}"
                                        EditingElementStyle="{StaticResource CenteredCheckBoxStyle}"/>
                <DataGridTextColumn Header="Current Number" Binding="{Binding CurrentNumber}" IsReadOnly="True" Width="130"/>
                <DataGridTextColumn Header="New Number" Binding="{Binding NewNumber, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                <DataGridTextColumn Header="Current Sheet Name" Binding="{Binding CurrentName}" IsReadOnly="True" Width="180"/>
                <DataGridTextColumn Header="New Sheet Name" Binding="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                <DataGridTextColumn Header="Title Block" Binding="{Binding TitleBlockName}" IsReadOnly="True" Width="180"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="1" Header="Selected Sheet and Title Block Parameters" Margin="0,0,0,10">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Refresh Parameters" Width="130" DockPanel.Dock="Left" Click="RefreshParameters_Click"/>
                    <TextBlock Text="  Displays and edits sheet parameters and title block instance parameters."
                               Foreground="{StaticResource MutedTextBrush}"/>
                </DockPanel>
                <DataGrid x:Name="ParameterGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="145"
                          DockPanel.Dock="Top" SelectionChanged="ParameterGrid_SelectionChanged"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" IsReadOnly="True" Width="125"/>
                        <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" IsReadOnly="True" Width="220"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" IsReadOnly="True" Width="120"/>
                        <DataGridTextColumn Header="Current Value" Binding="{Binding CurrentValue}" IsReadOnly="True" Width="180"/>
                        <DataGridTextColumn Header="New Value" Binding="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Values by sheet for the selected parameter (new values can be edited individually)"
                           DockPanel.Dock="Top" Margin="0,8,0,5" FontWeight="SemiBold"/>
                <Border DockPanel.Dock="Top" Height="202" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1">
                    <DataGrid x:Name="SheetParameterGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              RowHeight="34" VerticalAlignment="Stretch"
                              HeadersVisibility="Column" GridLinesVisibility="All"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sheet Number" Binding="{Binding SheetNumber}" IsReadOnly="True" Width="105"/>
                            <DataGridTextColumn Header="Sheet Name" Binding="{Binding SheetName}" IsReadOnly="True" Width="220"/>
                            <DataGridTextColumn Header="Current Value" Binding="{Binding CurrentValue}" IsReadOnly="True" Width="220"/>
                            <DataGridTextColumn Header="New Value" Binding="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </GroupBox>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="5" Padding="10,6">
                <TextBlock x:Name="MessageText" Foreground="#9A3412" TextWrapping="Wrap"/>
            </Border>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Validate" Width="90" Margin="8,0" Click="Validate_Click"/>
                <Button Content="Apply" Width="100" IsDefault="True" Margin="0,0,8,0" Click="Apply_Click"
                        Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="Close" Width="90" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
